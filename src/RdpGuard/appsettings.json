{
  "RdpGuard": {
    // true: всё считается и пишется в лог, но брандмауэр не изменяется.
    // Переключите в false после того, как убедитесь, что в "rdpguard bans" нет лишних адресов.
    "DryRun": true,

    // БД (rdpguard.db) и логи (logs\). Переменные окружения раскрываются.
    "DataDirectory": "%ProgramData%\\RdpGuard",

    "Detection": {
      // Учитываемые типы входа: 3 = сетевой (SMB, RDP с NLA), 10 = RemoteInteractive (RDP без NLA).
      "LogonTypes": [ 3, 10 ],
      // Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational, событие 140.
      "EnableRdpCoreTs": true,
      // Событие 140 и 4625 с одного IP с разницей не больше N секунд считаются одной попыткой.
      "RdpCoreTsDedupSeconds": 5,
      // При самом первом запуске (нет закладки в БД) прочитать события за последние N минут.
      "InitialLookbackMinutes": 60,
      // Записывать успешные входы (4624) с внешних адресов.
      "TrackSuccessfulLogons": true
    },

    "Policy": {
      // Бан, если за окно FailureWindow было >= MaxFailures неудачных входов.
      "MaxFailures": 10,
      "FailureWindow": "00:10:00",
      // Срок бана = BaseBanDuration * 2^(n-1), не больше MaxBanDuration. Формат: d.hh:mm:ss
      "BaseBanDuration": "1.00:00:00",
      "MaxBanDuration": "30.00:00:00",
      // 0 = выключено. K > 0: нарушение номер K+1 и последующие — бан навсегда.
      "PermanentAfterOffenses": 0,
      // Счётчик нарушений обнуляется, если IP не появлялся столько дней.
      "OffenseResetDays": 90,
      // Не банить IP, с которого был успешный вход за последние N дней.
      "SuccessTrustDays": 30,
      // Успешный вход с IP снимает его активный бан.
      "SuccessfulLogonLiftsBan": true
    },

    "Whitelist": {
      // 10/8, 172.16/12, 192.168/16, 127/8, 169.254/16, 100.64/10, ::1, fe80::/10, fc00::/7
      "TrustPrivateRanges": true,
      // Дополнительные адреса и сети, например "203.0.113.0/24", "2001:db8::/32".
      "Cidrs": []
    },

    "Firewall": {
      // AllPorts — блокировать все входящие с адреса; RdpPort — только TCP-порт RDP.
      "Scope": "AllPorts",
      // 0 = взять порт RDP из реестра (RDP-Tcp\PortNumber), по умолчанию 3389.
      "RdpPort": 0,
      // Адресов в одном правиле RdpGuard-Block-NN (1..1000).
      "MaxAddressesPerRule": 1000
    },

    "Storage": {
      // Сколько дней хранить попытки входа (attempts) и успешные входы (successes).
      "AttemptRetentionDays": 30
    },

    "FileLog": {
      "Enabled": true,
      "MaxFileSizeMB": 10,
      "RetainedFiles": 10
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "RdpGuard.Audit": "Information"
      }
    }
  }
}
