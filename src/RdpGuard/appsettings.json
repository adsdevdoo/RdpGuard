{
  // Заводские настройки RdpGuard. Этот файл ЗАМЕНЯЕТСЯ при обновлении программы.
  // Настройки своего сервера пишите в %ProgramData%\RdpGuard\appsettings.local.json:
  // он перекрывает этот файл и обновлением не затрагивается (install создаёт шаблон).
  "RdpGuard": {
    // true: всё считается и пишется в лог, но брандмауэр не изменяется.
    // Переключите в false после того, как убедитесь, что в "rdpguard bans" нет лишних адресов.
    "DryRun": true,

    // БД (rdpguard.db) и логи (logs\). Переменные окружения раскрываются.
    "DataDirectory": "%ProgramData%\\RdpGuard",

    "Detection": {
      // Учитываемые типы входа: 3 = сетевой (SMB, RDP с NLA), 10 = RemoteInteractive (RDP без NLA).
      "LogonTypes": [ 3, 10 ],
      // Microsoft-Windows-RemoteDesktopServices-RdpCoreTS/Operational, событие 140.
      "EnableRdpCoreTs": true,
      // Событие 140 и 4625 с одного IP с разницей не больше N секунд считаются одной попыткой.
      "RdpCoreTsDedupSeconds": 5,
      // При самом первом запуске (нет закладки в БД) прочитать события за последние N минут.
      "InitialLookbackMinutes": 60,
      // Записывать успешные входы (4624) с внешних адресов.
      "TrackSuccessfulLogons": true,
      // Проверять при старте и раз в час, что аудит входов (Success и Failure) включён, и включать его.
      "EnsureLogonAuditing": true
    },

    "Policy": {
      // Правила бана: срабатывает любое. Порог 0 выключает правило. Формат времени: d.hh:mm:ss
      // Подбор пароля к СУЩЕСТВУЮЩЕЙ учётке (Windows: SubStatus 0xC000006A).
      "WrongPasswordMaxFailures": 5,
      "WrongPasswordWindow": "1.00:00:00",
      // Перебор несуществующих имён: admin, Administrator, user... (SubStatus 0xC0000064).
      "NoSuchUserMaxFailures": 3,
      "NoSuchUserWindow": "1.00:00:00",
      // Оба вида неудач вместе (несуществующее имя ИЛИ неверный пароль): медленный подбор,
      // который меняет имена и не набирает порог ни одного правила по отдельности.
      "BadCredentialsMaxFailures": 3,
      "BadCredentialsWindow": "1.00:00:00",
      // Бот «по таймеру»: N попыток подряд с почти равными интервалами (разброс не больше доли), при любой частоте.
      "PeriodicMinAttempts": 5,
      "PeriodicMaxDeviation": 0.1,
      "PeriodicWindow": "1.00:00:00",
      // Быстрый перебор.
      "MaxFailures": 5,
      "FailureWindow": "00:10:00",
      // Медленный перебор.
      "SlowMaxFailures": 15,
      "SlowFailureWindow": "1.00:00:00",
      // Не бан, а предупреждение (событие 1009): столько неверных паролей к одной учётке за сутки
      // минимум с AccountAlertMinIps разных адресов — распределённый подбор.
      "AccountAlertWrongPasswords": 20,
      "AccountAlertMinIps": 3,

      // Срок бана = BaseBanDuration * 2^(n-1), не больше MaxBanDuration. Формат: d.hh:mm:ss
      "BaseBanDuration": "1.00:00:00",
      "MaxBanDuration": "30.00:00:00",
      // 0 = выключено. K > 0: нарушение номер K+1 и последующие — бан навсегда.
      "PermanentAfterOffenses": 0,
      // Счётчик нарушений обнуляется, если IP не появлялся столько дней.
      "OffenseResetDays": 90,
      // Не банить IP, с которого был успешный вход за последние N дней.
      "SuccessTrustDays": 30,
      // Успешный вход с IP снимает его активный бан.
      "SuccessfulLogonLiftsBan": true
    },

    "Whitelist": {
      // 10/8, 172.16/12, 192.168/16, 127/8, 169.254/16, 100.64/10, ::1, fe80::/10, fc00::/7
      "TrustPrivateRanges": true,
      // Дополнительные адреса и сети, например "203.0.113.0/24", "2001:db8::/32".
      "Cidrs": []
    },

    "Firewall": {
      // AllPorts — блокировать все входящие с адреса; RdpPort — только TCP-порт RDP.
      "Scope": "AllPorts",
      // 0 = взять порт RDP из реестра (RDP-Tcp\PortNumber), по умолчанию 3389.
      "RdpPort": 0,
      // Адресов в одном правиле RdpGuard-Block-NN (1..1000).
      "MaxAddressesPerRule": 1000
    },

    "Storage": {
      // Сколько дней хранить попытки входа (attempts) и успешные входы (successes).
      "AttemptRetentionDays": 30
    },

    "Api": {
      // HTTP API статистики: /metrics (Prometheus) и /api/* (JSON для Grafana Infinity).
      "Enabled": true,
      // Адреса для HttpListener, каждый с '/' в конце. Пусто = только http://127.0.0.1:9645/.
      // Для доступа с другого хоста задайте список целиком в appsettings.local.json, например
      // [ "http://127.0.0.1:9645/", "http://192.168.1.4:9645/" ], и откройте порт только для Prometheus/Grafana.
      "Urls": [],
      // С каких адресов принимать запросы (IP или CIDR). Пусто = только localhost (127.0.0.0/8, ::1).
      "AllowedClients": [],
      // Требовать "Authorization: Bearer <token>". Токен: RdpGuard api-token create grafana
      "RequireToken": true
    },

    "FileLog": {
      "Enabled": true,
      "MaxFileSizeMB": 10,
      "RetainedFiles": 10
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Warning",
        "RdpGuard.Audit": "Information"
      }
    }
  }
}
